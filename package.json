{
  "name": "spice-client",
  "version": "1.0.0",
  "description": "TypeScript port of spice-html5 - a JavaScript client for the SPICE protocol",
  "type": "module",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./global": "./dist/global/spice-client.min.js"
  },
  "scripts": {
    "build": "vite build --config build/vite.config.ts && tsc --project build/tsconfig.types.json || true",
    "dev": "cd src/web-demo && npm run dev",
    "server": "cd src/web-demo && npm run server",
    "test": "vitest run tests/unit",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "install:all": "npm install && cd src/web-demo && npm install",
    "start": "npm run server & npm run dev",
    "lint": "ts-standard",
    "lint:fix": "ts-standard --fix",
    "format": "ts-standard --fix"
  },
  "ts-standard": {
    "files": [
      "src/spice/**/*.ts"
    ],
    "env": {
      "browser": true,
      "node": true
    },
    "ignore": [
      "tests/**",
      "build/**",
      "src/web-demo/**",
      "vitest.config.ts",
      "playwright.config.ts"
    ]
  },
  "keywords": [
    "spice",
    "spice-html5",
    "remote-desktop",
    "websocket",
    "vnc",
    "html5",
    "typescript"
  ],
  "author": "Original: SPICE Project <spice-devel@lists.freedesktop.org> (https://www.spice-space.org)",
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://gitlab.freedesktop.org/spice/spice-html5.git"
  },
  "homepage": "https://www.spice-space.org",
  "bugs": {
    "url": "https://gitlab.freedesktop.org/spice/spice-html5/-/issues"
  },
  "files": [
    "dist",
    "LICENSE",
    "COPYING",
    "COPYING.LESSER",
    "README.md"
  ],
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/express": "^4.17.21",
    "@types/express-ws": "^3.0.4",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.2.1",
    "express": "^4.18.2",
    "express-ws": "^5.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-standard": "^12.0.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^4.0.18",
    "ws": "^8.14.2"
  }
}
